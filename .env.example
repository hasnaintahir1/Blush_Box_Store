# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional Groq API key for AI assistant (defaults to server-side Gemini if not set)
GROQ_API_KEY=""

# MONGODB_URI: MongoDB connection string (e.g. mongodb+srv://... or mongodb://localhost:27017/lumiere_gifts)
# App automatically uses persistent in-memory/file-backed database storage if not provided.
MONGODB_URI=""

# JWT_SECRET: Secret for customer and admin authentication tokens
JWT_SECRET="lumiere_luxury_gifting_secret_key_2026"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_NOTIFICATION_EMAIL: Email address that receives instant order notifications
ADMIN_NOTIFICATION_EMAIL="hasnaintahir605@gmail.com"

# Optional SMTP Configuration for live email sending
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="orders@blushbox.com"
